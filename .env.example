# Copy to .env and fill in your values

# ========================================
# Provider Selection (enable one provider)
# ========================================
USE_AZURE_OPENAI=true
# USE_OPENAI=false
# USE_ANTHROPIC=false
# USE_GOOGLE=false

# ========================================
# Azure OpenAI Configuration
# ========================================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Only gpt-4.1-mini is used; every tier runs on it.
AZURE_DEPLOYMENT_FRONTIER=gpt-4.1-mini
AZURE_DEPLOYMENT_WORKHORSE=gpt-4.1-mini
AZURE_DEPLOYMENT_FAST=gpt-4.1-mini

# ========================================
# OpenAI Configuration
# ========================================
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL_FRONTIER=gpt-4
# OPENAI_MODEL_WORKHORSE=gpt-4-turbo
# OPENAI_MODEL_FAST=gpt-4-mini

# ========================================
# Anthropic Claude Configuration
# ========================================
# Not needed for the Claude recommendations — those are a lookup table
# (claude_equivalents.py). Only set these to actually run on Claude.
# ANTHROPIC_API_KEY=your-api-key-here
# ANTHROPIC_MODEL_FRONTIER=claude-opus-5
# ANTHROPIC_MODEL_WORKHORSE=claude-sonnet-5
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# ========================================
# Google Gemini Configuration
# ========================================
# GOOGLE_API_KEY=your-api-key-here
# GOOGLE_MODEL_FRONTIER=gemini-pro
# GOOGLE_MODEL_WORKHORSE=gemini-1.5-pro
# GOOGLE_MODEL_FAST=gemini-1.5-flash

# ========================================
# Cost Estimates ($/1M tokens, for eval reports)
# ========================================
# (Claude prices for the "COST ON CLAUDE" line live in claude_equivalents.py)
COST_IN_FRONTIER=0.4
COST_OUT_FRONTIER=1.6
COST_IN_WORKHORSE=0.4
COST_OUT_WORKHORSE=1.6
COST_IN_FAST=0.4
COST_OUT_FAST=1.6
